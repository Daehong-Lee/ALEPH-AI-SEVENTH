{
  "schema": "pds-schema-v2-auth-d2-plan-task-v3",
  "timezone": "Asia/Seoul",
  "tables": {
    "d2_profiles": {
      "owner": "auth.users.id"
    },
    "d2_plans": {
      "owner": "user_id",
      "children": [
        "d2_tasks"
      ]
    },
    "d2_plan_versions": {
      "owner": "user_id",
      "parent": "d2_plans"
    },
    "d2_tasks": {
      "owner": "user_id",
      "parent": "d2_plans",
      "completion": "d2_task_completions"
    },
    "d2_task_completions": {
      "owner": "user_id",
      "one_per_task": true
    },
    "d2_execution_logs": {
      "owner": "user_id",
      "source": "d2_complete_task_once",
      "grouping": "completed_date"
    },
    "d2_plan_completions": {
      "owner": "user_id",
      "parent": "d2_plans",
      "one_per_plan": true
    }
  },
  "rules": {
    "tasks_created_with_plan": true,
    "task_tab_removed": true,
    "manual_execution_log_entry": false,
    "completion_creates_execution_log": true,
    "completion_moves_ui_item_to_completed": true,
    "completed_tab_sort": "completed_at_desc",
    "completed_items_read_only": true,
    "task_tags_displayed": true,
    "rls": "auth.uid() = user_id",
    "plan_completion_creates_record": true,
    "completed_plan_hidden_from_plan_tab": true,
    "completed_plan_is_read_only": true
  }
}
